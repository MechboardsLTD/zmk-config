#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
/ {
    behaviors {
        // Plain mod-tap: hold only after tapping-term-ms with no other decision path.
        // No positional hold — that caused early mods on rolls with balanced/tap-preferred mix.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                            display-name = "Base";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
&kp C_AC_SCROLL_UP   	&kp Q		&kp W		&kp E  		&kp R		&kp T  	&kp Y  	&kp U		&kp I		&kp O		&kp P		&kp C_AC_SCROLL_DOWN
&kp CAPSLOCK 		&kp A		&hml LALT S  	&hml LCTRL D   	&hml LSHFT F  	&kp G   &kp H   &hmr RSHFT J    &hmr RCTRL K   	&hmr RALT L 	&kp SEMI 	&kp PRINTSCREEN
&kp TAB			&kp Z		&kp X		&kp C     	&kp V  		&kp B    	&kp N   	&kp M           &kp COMMA      &kp DOT  	&kp FSLH  	&kp BSPC
                         				&kp LGUI  	&mo 1  		&kp SPACE    	&kp RET		&mo 2		&kp ESC

                        >;
                };
                lower_layer {
                        display-name = "Lower";
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <

&trans       		&kp N1		&kp N2		&kp N3		&kp N4		&kp N5	&kp N6		&kp N7          &kp N8      	&kp N9		&kp N0  	&trans       
&trans			&trans		&trans      	&trans   	&trans		&trans	&kp LEFT	&kp DOWN	&kp UP		&kp RIGHT	&kp APOS 	&trans	
&kp CAPS		&trans		&trans		&trans		&trans		&trans	&trans		&trans		&trans		&trans		&trans		&kp DEL
                                        		&trans     	&trans          &trans  &trans   	&trans 		&trans
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <


&trans			&kp LS(N1)	&kp LS(N2)	&kp LS(N3)	&kp LS(N4)	&kp LS(N5)	&kp LS(N6)	&kp LS(N7)	&kp LS(N8)	&kp LS(N9)	&kp LS(N0)	&trans
&trans			&trans	 	&trans          &kp PG_UP	&none		&trans		&kp MINUS   	&kp EQUAL       &kp LBKT	&kp RBKT 	&kp BSLH 	&trans
&trans  		&trans		&kp HOME	&kp PG_DN	&kp END		&trans		&kp LS(MINUS) 	&kp LS(EQUAL)   &kp LBRC  	&kp RBRC  	&trans  	&trans 
							&trans		&trans           &trans          &trans		&trans		&kp GRAVE

                        >;
                };

        	device {
            bindings = <
&trans               	&kp F1       	&kp F2                  &kp F3              	&kp F4            &kp F5       &kp F6       &kp F7          	&kp F8         &kp F9       &kp F10 		&trans
&trans              	&none        	&kp C_BRIGHTNESS_DEC    &kp C_BRIGHTNESS_INC 	&none             &none        &bt BT_SEL 0 &bt BT_SEL 1  	&bt BT_SEL 2   &bt BT_SEL 3 &bt BT_SEL 4 	&trans
&none			&kp K_MUTE  	&kp C_VOLUME_DOWN       &kp C_VOLUME_UP     	&kp C_PLAY_PAUSE  &none        &none        &none          	&none          &none        &none        	&bt BT_CLR
                                                		&none               	&none             &none        &none        &none           	&none
            		>;
        	};                
		extra2 {
                        display-name = "Extra-2";
                        status = "reserved";
                };

        	extra3 {
                        display-name = "Extra-3";
                        status = "reserved";
                };
        };
	conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
